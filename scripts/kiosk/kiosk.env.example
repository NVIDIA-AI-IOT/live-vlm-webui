# Shell configuration, sourced by the kiosk launchers. Keep this file private.
# Use the same desktop account for installation, automatic login, and Chromium.
KIOSK_SERVER_BIN="$HOME/.local/bin/live-vlm-webui"
KIOSK_PORT=8090
KIOSK_API_BASE=http://localhost:11434/v1
# Download and test this model on your device before enabling the kiosk.
KIOSK_MODEL=llava:7b
KIOSK_PROMPT='Describe what you see in this image in one sentence.'
KIOSK_PROCESS_EVERY=30
KIOSK_MAX_TOKENS=128

# A successful HTTP response gates browser launch, not model warm-up/inference.
# Change this for vLLM/SGLang; leave empty to skip the backend readiness probe.
KIOSK_BACKEND_READY_URL=http://localhost:11434/v1/models
# Optional executable path. Empty selects chromium, chromium-browser, or Chrome.
KIOSK_BROWSER=
# Non-hidden home directory also works with Ubuntu's Chromium snap confinement.
KIOSK_BROWSER_PROFILE="$HOME/live-vlm-webui-kiosk-profile"
